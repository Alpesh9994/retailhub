/* To learn more about Typescript configuration file: https://www.typescriptlang.org/docs/handbook/tsconfig-json.html. */
/* To learn more about Angular compiler options: https://angular.dev/reference/configs/angular-compiler-options. */
{
  "compileOnSave": false,
  "compilerOptions": {
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "paths": {
      "@retailhub/shared-api": ["./libs/shared-api/src/public-api.ts"],
      "@retailhub/shared-auth": ["./libs/shared-auth/src/public-api.ts"],
      "@retailhub/shared-models": ["./libs/shared-models/src/public-api.ts"],
      "@retailhub/shared-ui": ["./libs/shared-ui/src/public-api.ts"],
      "@retailhub/shared-utils": ["./libs/shared-utils/src/public-api.ts"]
    },
    "target": "ES2022",
    "module": "preserve"
  },
  "angularCompilerOptions": {
    "enableI18nLegacyMessageIdFormat": false,
    "strictInjectionParameters": true,
    "strictInputAccessModifiers": true
  },
  "files": [],
  "references": [
    {
      "path": "./apps/shell/tsconfig.app.json"
    },
    {
      "path": "./apps/shell/tsconfig.spec.json"
    },
    {
      "path": "./apps/product/tsconfig.app.json"
    },
    {
      "path": "./apps/product/tsconfig.spec.json"
    },
    {
      "path": "./apps/purchasing/tsconfig.app.json"
    },
    {
      "path": "./apps/purchasing/tsconfig.spec.json"
    },
    {
      "path": "./libs/shared-ui/tsconfig.lib.json"
    },
    {
      "path": "./libs/shared-ui/tsconfig.spec.json"
    },
    {
      "path": "./libs/shared-models/tsconfig.lib.json"
    },
    {
      "path": "./libs/shared-models/tsconfig.spec.json"
    },
    {
      "path": "./libs/shared-utils/tsconfig.lib.json"
    },
    {
      "path": "./libs/shared-utils/tsconfig.spec.json"
    },
    {
      "path": "./libs/shared-api/tsconfig.lib.json"
    },
    {
      "path": "./libs/shared-api/tsconfig.spec.json"
    },
    {
      "path": "./libs/shared-auth/tsconfig.lib.json"
    },
    {
      "path": "./libs/shared-auth/tsconfig.spec.json"
    }
  ]
}
